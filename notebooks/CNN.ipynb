   "cell_type": "code",
   "source": [
    "import torch\n",
    "import torch.nn as nn\n",
    "\n",
    "class ConvBlock(nn.Module):\n",
    "\n",
    "  def __init__(self, in_channels, out_channels):\n",
    "    super(ConvBlock, self).__init__()\n",
    "    self.block = nn.Sequential(\n",
    "        nn.Conv2d(\n",
    "            in_channels, out_channels, kernel_size=(1, 3), padding=(0, 1)\n",
    "        ),\n",
    "        nn.ReLU(),\n",
    "        nn.Conv2d(\n",
    "            out_channels, out_channels, kernel_size=(1, 3), padding=(0, 1)\n",
    "        ),\n",
    "        nn.ReLU(),\n",
    "        nn.MaxPool2d(kernel_size=(1, 2)),\n",
    "    )\n",
    "\n",
    "  def forward(self, x):\n",
    "    return self.block(x)\n",
    "\n",
    "\n",
    "class BrainAgeCNN(nn.Module):\n",
    "\n",
    "  def __init__(self, n_samples=1024, widths=(32, 64, 128)):\n",
    "    super(BrainAgeCNN, self).__init__()\n",
    "    w1, w2, w3 = widths\n",
    "\n",
    "    self.conv1 = ConvBlock(1, w1)\n",
    "    self.conv2 = ConvBlock(w1, w2)\n",
    "    self.conv3 = ConvBlock(w2, w3)\n",
    "\n",
    "    self.fc = nn.Sequential(\n",
    "        nn.Linear(w3 * (n_samples // 8), 128),\n",
    "        nn.ReLU(),\n",
    "        nn.Linear(128, 1),\n",
    "    )\n",
    "\n",
    "  def forward(self, x):                           # x: (B, C, T)\n",
    "    if x.dim() == 3:\n",
    "      x = x.unsqueeze(1)                          # (B, 1, C, T)\n",
    "\n",
    "    x = self.conv3(self.conv2(self.conv1(x)))     # (B, w3, C, T/8)\n",
    "    x = x.permute(0, 2, 1, 3).flatten(2)          # (B, C, w3 * T/8)\n",
    "    x = self.fc(x)                                # (B, C, 1)\n",
    "    x = x.squeeze(-1).max(dim=1).values           # MaxPool over the C channels -> (B,)\n",
    "    return x\n",
    "\n",
    "model = BrainAgeCNN(n_samples=RESAMPLING_RATE * SEGMENT_DURATION)\n",
    "sample_batch, labels, _ = next(iter(train_loader))\n",
    "output = model(sample_batch)\n",
    "print(\"Model output shape:\", output.shape)"
