    "import os\n",
    "import torch\n",
    "from torch.utils.data import Dataset\n",
    "import random\n",
    "\n",
    "class EEGDataset(Dataset):\n",
    "    def __init__(self, file_path, segments, segment_duration, sampling_rate, cache_size=None, random_crop=False,):\n",
    "        self.file_path = file_path\n",
    "        self.segments = segments\n",
    "        self.segment_duration = 1.0*segment_duration\n",
    "        self.sampling_rate = sampling_rate\n",
    "        self.random_crop = random_crop\n",
    "        if cache_size is None:\n",
    "            self.max_cache_size = 0\n",
    "        elif cache_size == 'inf':\n",
    "            self.max_cache_size = 10E9 # Number of elements (2 bytes per element)\n",
    "        else:\n",
    "            self.max_cache_size = cache_size # Max number of samples stored in the cache on each worker\n",
    "        self.cache_size = 0\n",
    "        self.file_cache = {}\n",
    "\n",
    "    def __len__(self):\n",
    "        return len(self.segments)\n",
    "\n",
    "    def __getitem__(self, idx):\n",
    "        torch_file = self.segments[idx][4]\n",
    "        istart = int(self.segments[idx][0]*self.sampling_rate)\n",
    "        label = self.segments[idx][3]\n",
    "        n_samples = int(self.sampling_rate*self.segment_duration)\n",
    "\n",
    "        # Caching - Store EEG in a dictionary for fast lookup\n",
    "        if torch_file in self.file_cache:\n",
    "            data = self.file_cache[torch_file]\n",
    "        else:\n",
    "            data = torch.load(os.path.join(self.file_path, 'pre_processed/' + torch_file.replace('.edf','.pt')))\n",
    "            if self.cache_size + torch.numel(data) < self.max_cache_size:\n",
    "                self.file_cache[torch_file] = data\n",
    "                self.cache_size += torch.numel(data)\n",
    "        assert(data.shape[1] >= n_samples)\n",
    "\n",
    "        if self.random_crop:\n",
    "          # Randomly select a start time (in seconds) within the recording length\n",
    "          max_duration = (data.shape[1] / self.sampling_rate) - self.segment_duration\n",
    "          if max_duration > 0:\n",
    "            b_start = random.uniform(0, max_duration)\n",
    "          else:\n",
    "            b_start = 0.0\n",
    "        else:\n",
    "          # Default deterministic start for validation/testing\n",
    "          b_start = self.segments[idx][2]\n",
    "        istart = int(b_start*self.sampling_rate)\n",
    "        data1 = data[:, istart:(istart + n_samples)] # Copy data prior to type conversion/augmentation\n",
    "        assert(data1.shape[1] == n_samples) # slicing out of bounds in pytorch is silent, therefore need to check\n",
    "        if data1.dtype != torch.float32:\n",
    "            data1 = data1.to(torch.float32) # Pytorch operates in float32 by default\n",
    "\n",
    "        # TODO: Add augmentation code here if you decide to use augmentation\n",
    "        return data1, label, idx\n",
    "\n",
    "    def clear_cache():\n",
    "        self.file_cache.clear()\n",
    "        self.cache_size = 0\n",
    "import os\n",
    "from pathlib import Path\n",
    "import torch\n",
    "\n",
    "RESAMPLING_RATE = 64\n",
    "SEGMENT_DURATION = 8 # TODO: Decide on appropriate block size for your model\n",
    "\n",
    "BATCH_SIZE = 64 # TODO: Modify as needed\n",
    "\n",
    "path = Path('/content/drive/MyDrive/BrainAge/data')\n",
    "pre_processed_path = path / Path('pre_processed')\n",
    "\n",
    "train_segments = torch.load(path / 'segments_h1k_train.pt')\n",
    "val_segments = torch.load(path / 'segments_h1k_val.pt')\n",
    "test_segments = torch.load(path / 'segments_h1k_test.pt')\n",
    "from torch.utils.data import DataLoader\n",
    "\n",
    "train_dataset = EEGDataset(path, train_segments,\n",
    "                           segment_duration=SEGMENT_DURATION,\n",
    "                           sampling_rate=RESAMPLING_RATE,\n",
    "                           cache_size=2E9, random_crop=True)\n",
    "\n",
    "train_loader = DataLoader(train_dataset, batch_size=BATCH_SIZE, num_workers = 0, shuffle=True)\n",
    "\n",
    "it = iter(train_loader)\n",
    "data, label, _ = next(it)\n",
    "\n",
    "data.shape, len(label)"
   ],
